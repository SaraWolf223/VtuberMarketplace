# Expo public (safe in client bundle)
# EAS — run `npx eas init` once; copy project ID here for OTA updates URL in app.config.ts
# EXPO_OWNER=your-eas-account
# EXPO_SLUG=local-marketplace
# EAS_PROJECT_ID=
APP_DISPLAY_NAME=Local Marketplace
APP_SCHEME=localmarketplace
APP_DOMAIN=yourdomain.com
IOS_BUNDLE_IDENTIFIER=com.example.localmarketplace
ANDROID_PACKAGE=com.example.localmarketplace
# IOS_MERCHANT_IDENTIFIER=merchant.com.example.localmarketplace

# Android native build compatibility for Google Mobile Ads is handled in app.config.ts.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_POSTHOG_KEY=

# Optional bot protection for the web sign-up form (Cloudflare Turnstile).
# Leave blank to skip — sign-up works without it. Pairs with TURNSTILE_SECRET_KEY below.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# AdMob (use Google test IDs in development)
ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-3940256099942544/2934735716
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-3940256099942544/6300978111

# In-feed native/video ads (OfferUp-style) — placeholders until account is ready
EXPO_PUBLIC_GOOGLE_FEED_VIDEO_ADS_ENABLED=true
# EXPO_PUBLIC_GOOGLE_FEED_VIDEO_ADS_LIVE=true
# EXPO_PUBLIC_ADMOB_IOS_NATIVE_VIDEO_ID=
# EXPO_PUBLIC_ADMOB_ANDROID_NATIVE_VIDEO_ID=

# Full-screen ads — App Open (shown when switching back into the app) + capped
# Interstitial (shown at browse breaks). Uses Google test units until the IDs
# below are set AND the flag is on. Requires a native rebuild (EAS) to serve.
# EXPO_PUBLIC_FULLSCREEN_ADS_LIVE=true
# EXPO_PUBLIC_ADMOB_IOS_APP_OPEN_ID=
# EXPO_PUBLIC_ADMOB_ANDROID_APP_OPEN_ID=
# EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=
# EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=

# Supabase Edge / server only — NEVER commit real values
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PREMIUM=price_...  (Stripe recurring $5/mo price ID, test mode)
# MAPBOX_ACCESS_TOKEN=
# CRON_SECRET=  # REQUIRED in production — Bearer token for purge-expired-* edge functions
# COLLEGE_OTP_SECRET=  # REQUIRED in production — HMAC secret for college .edu OTP (do not reuse service role)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:8081
# RESEND_API_KEY=  # sends .edu verification, bulk, and staff-notify emails (dev logs instead if unset)
# COLLEGE_EMAIL_FROM=Local Marketplace <noreply@yourdomain.com>
# BULK_EMAIL_FROM=Local Marketplace <noreply@yourdomain.com>  # from-address for bulk + staff notifications
# SUPPORT_EMAIL=support@yourdomain.com  # admin-channel recipient for staff notifications (waitlist signups, reports, bans, etc.)
# TURNSTILE_SECRET_KEY=  # optional — pairs with EXPO_PUBLIC_TURNSTILE_SITE_KEY / waitlist-config.js turnstileSiteKey; unset = bot check skipped
