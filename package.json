{
  "name": "local-marketplace",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8081 --localhost",
    "start:lan": "powershell -NoProfile -Command \"$env:EXPO_NO_DEPENDENCY_VALIDATION='1'; npx expo start --port 8081 --lan\"",
    "android:open": "powershell -ExecutionPolicy Bypass -File scripts/open-android.ps1",
    "qr": "node scripts/expo-qr.mjs 8081",
    "device:qr": "powershell -ExecutionPolicy Bypass -File scripts/physical-device-qr.ps1",
    "seed:listings": "node scripts/seed-listings.mjs",
    "android": "powershell -ExecutionPolicy Bypass -File scripts/android-build-launcher.ps1",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/android-build-launcher.ps1",
    "android:build:device": "powershell -ExecutionPolicy Bypass -File scripts/android-build-launcher.ps1 -Device",
    "android:install": "powershell -ExecutionPolicy Bypass -File scripts/android-build-launcher.ps1 -InstallOnly",
    "android:emu": "powershell -ExecutionPolicy Bypass -File scripts/android-build-launcher.ps1 -EmuOnly",
    "android:emu-stop": "powershell -ExecutionPolicy Bypass -File scripts/android-emu-stop.ps1",
    "android:clean": "powershell -ExecutionPolicy Bypass -File scripts/android-build-launcher.ps1 -Clean -CleanOnly",
    "android:doctor": "powershell -ExecutionPolicy Bypass -File scripts/android-diagnose.ps1",
    "android:long-paths": "powershell -ExecutionPolicy Bypass -File scripts/enable-windows-long-paths.ps1",
    "android:icons": "expo prebuild --platform android",
    "android:prebuild": "expo prebuild --platform android",
    "android:reinstall": "powershell -ExecutionPolicy Bypass -File scripts/android-build-launcher.ps1 -Prebuild",
    "android:run-expo": "node -e \"console.error('Use npm run android:build instead of expo run:android on Windows.');process.exit(1)\"",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8081",
    "web:export": "expo export --platform web",
    "web:build": "node scripts/export-web-app.mjs",
    "web:build:sanitized": "node scripts/export-web-app.mjs --sanitized",
    "web:static-test": "node scripts/test-static-export-smoke.mjs",
    "web:test": "node scripts/test-web-smoke.mjs && node scripts/test-web-browser.mjs",
    "web:qa": "node scripts/test-web-qa-full.mjs",
    "web:qa:desktop": "node scripts/test-web-desktop-layout.mjs",
    "web:qa:mobile": "node scripts/test-web-mobile-layout.mjs",
    "generate:legal": "node scripts/generate-legal-content.mjs && node scripts/generate-legal-site.mjs",
    "serve:website": "npx --yes serve website -p 3456",
    "sync:waitlist-config": "node scripts/sync-waitlist-config.mjs",
    "capture:landing-phone": "node scripts/capture-landing-phone.mjs",
    "capture:marketing-feed": "node scripts/capture-marketing-screenshots.mjs",
    "gen-assets:from-logo": "node scripts/gen-assets-from-logo.mjs",
    "setup": "node scripts/setup-wizard.mjs",
    "setup:preview": "node scripts/setup-wizard.mjs --preview",
    "setup:check": "node scripts/setup-wizard.mjs --check",
    "setup:self-test": "node scripts/setup-wizard.mjs --self-test",
    "setup:apply": "node scripts/apply-buyer-setup.mjs",
    "setup:apply:dry": "node scripts/apply-buyer-setup.mjs --dry-run",
    "test": "node --test scripts/test-security-readiness.mjs",
    "test:security": "node --test scripts/test-security-readiness.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "eas:init": "eas init",
    "eas:validate": "node -e \"JSON.parse(require('fs').readFileSync('eas.json','utf8')); console.log('eas.json OK')\" && expo config --type public",
    "eas:build:preview:android": "eas build --profile preview --platform android",
    "eas:build:preview:ios": "eas build --profile preview --platform ios",
    "eas:build:production:android": "eas build --profile production --platform android",
    "eas:build:production:ios": "eas build --profile production --platform ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.6",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "16.1.2",
    "@stripe/stripe-react-native": "0.64.0",
    "@supabase/supabase-js": "2.110.2",
    "@tanstack/react-query": "5.100.13",
    "expo": "57.0.7",
    "expo-apple-authentication": "57.0.1",
    "expo-asset": "57.0.6",
    "expo-auth-session": "57.0.4",
    "expo-build-properties": "57.0.6",
    "expo-constants": "57.0.6",
    "expo-crypto": "57.0.1",
    "expo-device": "57.0.1",
    "expo-file-system": "57.0.1",
    "expo-font": "57.0.1",
    "expo-haptics": "57.0.1",
    "expo-image": "57.0.1",
    "expo-image-manipulator": "57.0.5",
    "expo-image-picker": "57.0.5",
    "expo-linking": "57.0.3",
    "expo-navigation-bar": "57.0.2",
    "expo-notifications": "57.0.6",
    "expo-router": "57.0.7",
    "expo-secure-store": "57.0.1",
    "expo-splash-screen": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.1",
    "expo-tracking-transparency": "57.0.1",
    "expo-updates": "57.0.8",
    "expo-web-browser": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.76.0",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-google-mobile-ads": "16.4.0",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.0",
    "zod": "3.25.76",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-plugin-transform-import-meta": "2.3.3",
    "babel-preset-expo": "57.0.3",
    "eslint": "10.7.0",
    "eslint-config-expo": "57.0.0",
    "playwright": "1.60.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.2",
    "typescript": "6.0.3"
  }
}
